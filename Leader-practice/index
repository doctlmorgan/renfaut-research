<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="color-scheme" content="light" />
<title>R.I.S.E. Index™ Leadership Practice Study</title>
<style>
:root {
  --charcoal:#2B2B2B;
  --muted:#686868;
  --line:#D9D9D9;
  --paper:#FFFFFF;
  --canvas:#F5F5F3;
  --rr:#B31217;
  --ib:#E76F00;
  --de:#F7B500;
  --rr-light:#FBF0F1;
  --ib-light:#FFF4EA;
  --de-light:#FFF8DE;
  --focus:#1F5A94;
}
* { box-sizing:border-box; }
html { scroll-behavior:smooth; }
body {
  margin:0; background:var(--canvas); color:var(--charcoal);
  font-family:Aptos, "Segoe UI", Arial, sans-serif; font-size:16px; line-height:1.5;
}
button,input,textarea { font:inherit; }
.shell { max-width:940px; margin:0 auto; padding:24px 18px 60px; }
.brandline { font-size:12px; font-weight:700; letter-spacing:.11em; text-transform:uppercase; color:#555; margin-bottom:18px; }
.card { background:var(--paper); border:1px solid #E1E1E1; border-radius:12px; padding:28px; }
.hero { padding:34px 32px; }
h1,h2,h3 { font-family:"Aptos Display", Aptos, "Segoe UI", Arial, sans-serif; margin:0; line-height:1.15; }
h1 { font-size:34px; font-weight:600; margin-bottom:10px; }
h2 { font-size:27px; font-weight:600; }
h3 { font-size:18px; font-weight:600; }
.lede { font-size:18px; color:#4D4D4D; max-width:720px; margin:10px 0 0; }
.meta { color:var(--muted); font-size:14px; margin-top:14px; }
.intro-grid { display:grid; grid-template-columns:minmax(0,1.15fr) minmax(300px,.85fr); gap:24px; align-items:start; }
.instructions { margin-top:22px; padding:18px; border:1px solid #E0E0DC; border-left:4px solid var(--rr); border-radius:10px; background:#FAFAF8; }
.instructions h3 { margin-bottom:8px; }
.instructions ol { margin:8px 0 0; padding-left:22px; }
.instructions li { margin:7px 0; }
.fact-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:10px; margin-top:20px; }
.fact { border-top:3px solid #6C3FBF; padding-top:9px; }
.fact strong { display:block; font-size:18px; }
.fact span { display:block; font-size:12px; color:var(--muted); }
.consent { display:flex; gap:9px; align-items:flex-start; margin-top:18px; font-size:14px; }
.consent input { margin-top:4px; }
.field { margin-top:24px; }
label.field-label { display:block; font-weight:600; margin-bottom:8px; }
input[type=text] { width:100%; max-width:420px; border:1px solid #BDBDBD; border-radius:8px; padding:11px 12px; background:white; }
.btn { border:0; border-radius:8px; padding:11px 18px; font-weight:700; cursor:pointer; background:var(--charcoal); color:white; }
.btn:hover { opacity:.92; }
.btn.secondary { background:#EFEFED; color:var(--charcoal); border:1px solid #D7D7D2; }
.btn:focus-visible, input:focus-visible, textarea:focus-visible { outline:3px solid rgba(31,90,148,.25); outline-offset:2px; }
.actions { display:flex; gap:10px; justify-content:space-between; flex-wrap:wrap; margin-top:28px; }
.progress-wrap { max-width:800px; margin:18px auto 18px; }
.progress-row { display:flex; justify-content:space-between; gap:16px; color:var(--muted); font-size:13px; margin-bottom:7px; }
.progress { height:7px; background:#E7E7E4; border-radius:99px; overflow:hidden; }
.progress > div { height:100%; background:var(--charcoal); width:0%; transition:width .2s ease; }
.practice { width:100%; max-width:800px; margin:0 auto; background:transparent; border:0; border-radius:0; padding:0; box-shadow:none; }
.practice-display {
  position:relative; overflow:hidden; background:#fff; border:1px solid #E3E3DF;
  width:100%; border-radius:22px; padding:34px 36px 32px; box-shadow:0 14px 38px rgba(43,43,43,.09);
}
.practice-display::before { content:""; position:absolute; inset:0 0 auto 0; height:6px; background:var(--accent); }
.practice-display::after { content:""; position:absolute; width:190px; height:190px; border-radius:50%; right:-84px; top:-92px; background:var(--light); opacity:.85; pointer-events:none; }
.practice-heading { position:relative; z-index:1; }
.practice .title { color:var(--accent); font-size:31px; letter-spacing:-.015em; }
.practice .problem { position:relative; z-index:1; margin:15px 0 0; font-size:18px; line-height:1.55; max-width:680px; color:#3F3F3F; }
.trybox { position:relative; z-index:1; margin:26px 8px 0; background:var(--light); border:1px solid color-mix(in srgb, var(--accent) 22%, #E4E4E0); border-left:5px solid var(--accent); padding:19px 21px; border-radius:12px; }
.trybox .trylabel { color:#343434; font-weight:700; font-size:13px; letter-spacing:.09em; text-transform:uppercase; margin-bottom:9px; }
.trybox ol { margin:0; padding-left:23px; }
.trybox li { margin:7px 0; line-height:1.48; }
.question-set { width:100%; margin:24px auto 0; background:#fff; border:1px solid #E1E1DE; border-radius:18px; padding:4px 28px 28px; box-shadow:0 8px 24px rgba(43,43,43,.05); }
.question { margin-top:28px; padding-top:24px; border-top:1px solid #E4E4E2; }
.question:first-of-type { margin-top:26px; }
.qnum { display:inline-flex; width:28px; height:28px; border-radius:50%; background:var(--light); align-items:center; justify-content:center; font-weight:700; margin-right:8px; border:1px solid color-mix(in srgb, var(--accent) 40%, #ddd); }
.qprompt { font-weight:600; font-size:17px; }
.options { margin-top:13px; display:grid; gap:9px; }
.option { display:flex; gap:10px; align-items:flex-start; border:1px solid #D8D8D6; padding:11px 12px; border-radius:8px; background:white; cursor:pointer; }
.option:hover { border-color:#AFAFAA; }
.option input { margin-top:4px; }
textarea { width:100%; min-height:120px; resize:vertical; border:1px solid #BDBDBD; border-radius:8px; padding:12px; background:white; margin-top:12px; }
.qual-help { font-size:12px; color:#A0181D; margin-top:7px; font-weight:600; }
.qual-counter { display:none; }
.qual-counter.complete { display:none; }
.invalid-input { border-color:var(--rr)!important; box-shadow:0 0 0 3px rgba(179,18,23,.10)!important; }
.qual-error { color:#A0181D; font-size:12px; font-weight:700; margin-top:7px; }
.either { margin-top:28px; padding:18px; background:#FAFAF8; border:1px solid #E2E2DE; border-radius:8px; }
.either-title { font-weight:700; margin-bottom:4px; }
.either-note { font-size:13px; color:var(--muted); margin:0 0 14px; }
.either-panel { margin-top:14px; padding-top:14px; border-top:1px solid #E5E5E1; }
.either-panel:first-of-type { border-top:0; padding-top:0; }
.either-label { font-weight:600; font-size:16px; }
.validation { color:#A0181D; font-size:14px; font-weight:600; margin-top:12px; display:none; }
.hidden { display:none !important; }
.complete h2 { margin-bottom:10px; }
.complete p { max-width:720px; }
.completion-grid { display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-top:24px; }
.completion-panel { border:1px solid #E0E0DC; border-radius:14px; padding:20px; background:#FAFAF8; }
.completion-panel h3 { margin-bottom:8px; }
.code-box { display:flex; align-items:center; gap:10px; flex-wrap:wrap; margin-top:14px; }
.survey-code { display:inline-block; padding:11px 14px; border:2px solid #D7D7D2; border-radius:9px; background:#fff; font:700 21px/1.2 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace; letter-spacing:.06em; color:var(--charcoal); user-select:all; }
.completion-actions { display:flex; flex-wrap:wrap; gap:10px; margin-top:16px; }
.completion-actions a.btn { text-decoration:none; display:inline-flex; align-items:center; justify-content:center; }
.profile-panel { border-top:4px solid #6C3FBF; background:#FBF9FE; }
.small { font-size:13px; color:var(--muted); }

.demographics-card { max-width:800px; margin:18px auto 0; padding:30px 32px; }
.demographics-card .lede { font-size:16px; max-width:680px; }
.demo-grid { display:grid; grid-template-columns:1fr 1fr; gap:18px 22px; margin-top:24px; }
.demo-field { min-width:0; }
.demo-field.full { grid-column:1 / -1; }
.demo-label { display:block; font-weight:600; margin-bottom:7px; }
.required-note { color:#8F171B; font-size:11px; font-weight:700; letter-spacing:.04em; text-transform:uppercase; margin-left:5px; }
.optional-note { color:var(--muted); font-size:12px; margin-left:5px; }
.demo-input,.demo-select { width:100%; border:1px solid #BDBDBD; border-radius:8px; padding:11px 12px; background:#fff; color:var(--charcoal); }
.demo-input:focus-visible,.demo-select:focus-visible { outline:3px solid rgba(31,90,148,.25); outline-offset:2px; }
.demo-help { font-size:12px; color:var(--muted); margin-top:6px; }
.demo-group { border:0; padding:0; margin:0; }
.demo-group legend { font-weight:600; margin-bottom:9px; }
.check-grid { display:grid; grid-template-columns:1fr 1fr; gap:8px 10px; }
.check-option { display:flex; gap:8px; align-items:flex-start; border:1px solid #D8D8D6; border-radius:8px; padding:10px 11px; background:#fff; font-size:14px; }
.check-option input { margin-top:3px; }
.reveal { margin-top:10px; padding:12px; background:#FAFAF8; border:1px solid #E2E2DE; border-radius:8px; }
.demo-error { color:#A0181D; font-size:12px; font-weight:700; margin-top:6px; display:none; }
.demo-field.has-error .demo-input,.demo-field.has-error .demo-select,.demo-group.has-error { border-color:var(--rr); }
.demo-field.has-error .demo-error,.demo-group.has-error .demo-error { display:block; }
.demographics-actions { max-width:800px; margin:20px auto 0; display:flex; justify-content:space-between; gap:10px; }

.footer { margin-top:20px; color:#757575; font-size:12px; text-align:center; }
.rr { --accent:var(--rr); --light:var(--rr-light); }
.ib { --accent:var(--ib); --light:var(--ib-light); }
.de { --accent:var(--de); --light:var(--de-light); }
@media (max-width:640px) {
  .shell { padding:14px 10px 40px; }
  .intro-grid,.fact-grid { grid-template-columns:1fr; }
  .card,.hero { padding:22px 18px; border-radius:12px; }
  .practice { padding:0; }
  .practice-display { padding:26px 20px 23px; border-radius:17px; }
  .trybox { margin-left:0; margin-right:0; }
  .question-set { padding:2px 18px 22px; border-radius:15px; }
  h1 { font-size:29px; } h2 { font-size:24px; }
  .practice .title { font-size:27px; }
  .actions .btn { width:100%; }
  .completion-grid { grid-template-columns:1fr; }
  .completion-actions .btn { width:100%; }
  .demo-grid,.check-grid { grid-template-columns:1fr; }
  .demographics-card { padding:24px 20px; }
  .demographics-actions .btn { flex:1; }
}
@media print {
  body { background:white; } .shell { max-width:none; } .actions,.progress-wrap,#startScreen,.footer { display:none !important; }
  .card { border:0; border-radius:0; padding:0; }
}
</style>
</head>
<body>
<div class="shell">
  <div class="brandline">RENFAUT™ &nbsp;|&nbsp; R.I.S.E. INDEX™ &nbsp;|&nbsp; LEADERSHIP PRACTICE STUDY</div>

  <section id="startScreen" class="card hero">
    <div class="intro-grid">
      <div>
        <div class="brandline" style="margin-bottom:10px">Leadership practice review</div>
        <h1>Help us study how leadership practices are understood.</h1>
        <p class="lede">You will review two leadership practices and respond to questions about what each practice is trying to accomplish, how it applies, and what change it could produce.</p>
        <div class="fact-grid" aria-label="Study details">
          <div class="fact"><strong>2</strong><span>leadership practices</span></div>
          <div class="fact"><strong>6</strong><span>questions for each practice</span></div>
          <div class="fact"><strong>Brief</strong><span>written reflection</span></div>
        </div>
        <div class="instructions">
          <h3>What you will do</h3>
          <ol>
            <li>Read each leadership practice and its <strong>TRY THIS</strong> action.</li>
            <li>Answer Questions 1–4 based on your understanding of the practice.</li>
            <li>For Question 3, explain your reasoning in your own words.</li>
            <li>For Questions 5 and 6, answer <strong>at least one</strong>. You may answer both.</li>
          </ol>
        </div>
      </div>
      <aside>
        <h3>Before you begin</h3>
        <p class="meta" style="margin-top:8px">Please respond based on what the leadership practice itself communicates. Do not search for an answer or use outside material while completing the review.</p>
        <div class="field">
          <label class="field-label" for="participantId">Participant code</label>
          <input id="participantId" type="text" autocomplete="off" minlength="6" maxlength="20" pattern="[A-Za-z0-9-]{6,20}" placeholder="Enter or create your study code" />
          <div class="small">Use 6–20 letters, numbers, or hyphens. Do not use your name, email address, or another identifying detail.</div>
        </div>
        <label class="consent"><input id="readyCheck" type="checkbox" /><span>I understand what I will be asked to do and am ready to begin.</span></label>
        <div class="actions" style="justify-content:flex-start">
          <button id="startBtn" class="btn" type="button">Begin study</button>
        </div>
        <div id="startError" class="validation">Please enter a valid participant code and confirm that you are ready to begin.</div>
      </aside>
    </div>
  </section>

  <div id="studyScreen" class="hidden">
    <div class="progress-wrap">
      <div class="progress-row"><span id="progressLabel">Practice 1 of 2</span><span id="progressPct">50%</span></div>
      <div class="progress"><div id="progressBar"></div></div>
    </div>
    <section id="practiceCard" class="card practice"></section>
  </div>


  <section id="demographicsScreen" class="card demographics-card hidden" aria-labelledby="demographicsTitle">
    <div class="brandline" style="margin-bottom:10px">Final step</div>
    <h2 id="demographicsTitle">About you</h2>
    <p class="lede">These questions help us understand how people from different backgrounds respond to the leadership practices. Every question except email requires a response; “Prefer not to answer” is available where appropriate.</p>

    <form id="demographicsForm" novalidate>
      <div class="demo-grid">
        <div id="ageField" class="demo-field">
          <label class="demo-label" for="ageRange">Age range <span class="required-note">Required</span></label>
          <select id="ageRange" class="demo-select">
            <option value="">Select one</option>
            <option>Under 18</option><option>18–24</option><option>25–34</option><option>35–44</option><option>45–54</option><option>55–64</option><option>65 or older</option><option>Prefer not to answer</option>
          </select>
          <div class="demo-error">Please select a response.</div>
        </div>
        <div id="countryField" class="demo-field">
          <label class="demo-label" for="country">Country <span class="required-note">Required</span></label>
          <input id="country" class="demo-input" type="text" autocomplete="country-name" placeholder="Country where you currently live" />
          <div class="demo-error">Please enter your country.</div>
        </div>
        <div id="roleField" class="demo-field full">
          <label class="demo-label" for="professionalRole">Professional role or title <span class="required-note">Required</span></label>
          <input id="professionalRole" class="demo-input" type="text" autocomplete="organization-title" placeholder="Your role or title" />
          <div class="demo-error">Please enter your professional role or title.</div>
        </div>
        <div id="sectorField" class="demo-field">
          <label class="demo-label" for="sector">Sector <span class="required-note">Required</span></label>
          <select id="sector" class="demo-select">
            <option value="">Select one</option>
            <option>Arts / Culture / Media</option>
            <option>Consulting / Professional Services</option>
            <option>Faith-based / Religious Organization</option>
            <option>Government / Public Administration</option>
            <option>Grassroots / Advocacy / Movement Organization</option>
            <option>Healthcare / Public Health</option>
            <option>Higher Education / Academia</option>
            <option>Human Services / Social Services</option>
            <option>K–12 Education</option>
            <option>Labor / Workforce Organization</option>
            <option>Nonprofit / Community-based Organization</option>
            <option>Philanthropy / Grantmaking</option>
            <option>Private Business / Corporate</option>
            <option value="__other__">Other / Self-describe</option>
            <option>Prefer not to answer</option>
          </select>
          <div id="sectorOtherWrap" class="reveal hidden">
            <label class="demo-label" for="sectorOther">Please self-describe your sector</label>
            <input id="sectorOther" class="demo-input" type="text" />
          </div>
          <div class="demo-error">Please select a sector and complete the self-description if needed.</div>
        </div>
        <div id="yearsField" class="demo-field">
          <label class="demo-label" for="leadershipYears">Years in leadership roles <span class="required-note">Required</span></label>
          <select id="leadershipYears" class="demo-select">
            <option value="">Select one</option>
            <option>Less than 1 year</option><option>1–3 years</option><option>4–6 years</option><option>7–10 years</option><option>11–15 years</option><option>More than 15 years</option><option>Prefer not to answer</option>
          </select>
          <div class="demo-error">Please select a response.</div>
        </div>

        <fieldset id="genderField" class="demo-group demo-field full">
          <legend>Gender identity <span class="required-note">Required · Select all that apply</span></legend>
          <div class="check-grid">
            <label class="check-option"><input type="checkbox" name="gender" value="Woman" /><span>Woman</span></label>
            <label class="check-option"><input type="checkbox" name="gender" value="Man" /><span>Man</span></label>
            <label class="check-option"><input type="checkbox" name="gender" value="Nonbinary" /><span>Nonbinary</span></label>
            <label class="check-option"><input type="checkbox" name="gender" value="Transgender" /><span>Transgender</span></label>
            <label class="check-option"><input type="checkbox" name="gender" value="Genderqueer / Gender non-conforming" /><span>Genderqueer / Gender non-conforming</span></label>
            <label class="check-option"><input type="checkbox" name="gender" value="Two-Spirit" /><span>Two-Spirit</span></label>
            <label class="check-option"><input id="genderOtherCheck" type="checkbox" name="gender" value="__other__" /><span>I prefer to self-describe</span></label>
            <label class="check-option"><input id="genderPna" type="checkbox" name="gender" value="Prefer not to answer" /><span>Prefer not to answer</span></label>
          </div>
          <div id="genderOtherWrap" class="reveal hidden">
            <label class="demo-label" for="genderOther">Please self-describe your gender identity</label>
            <input id="genderOther" class="demo-input" type="text" />
          </div>
          <div class="demo-error">Please select at least one response and complete the self-description if needed.</div>
        </fieldset>

        <fieldset id="raceField" class="demo-group demo-field full">
          <legend>Race and/or ethnicity <span class="required-note">Required · Select all that apply</span></legend>
          <div class="check-grid">
            <label class="check-option"><input type="checkbox" name="race" value="Black / African American" /><span>Black / African American</span></label>
            <label class="check-option"><input type="checkbox" name="race" value="Latine / Latinx / Hispanic" /><span>Latine / Latinx / Hispanic</span></label>
            <label class="check-option"><input type="checkbox" name="race" value="Native American / Indigenous / First Nations" /><span>Native American / Indigenous / First Nations</span></label>
            <label class="check-option"><input type="checkbox" name="race" value="Asian (East, South, Southeast, Central)" /><span>Asian (East, South, Southeast, Central)</span></label>
            <label class="check-option"><input type="checkbox" name="race" value="Middle Eastern or North African" /><span>Middle Eastern or North African</span></label>
            <label class="check-option"><input type="checkbox" name="race" value="Pacific Islander / Native Hawaiian" /><span>Pacific Islander / Native Hawaiian</span></label>
            <label class="check-option"><input type="checkbox" name="race" value="White / European descent" /><span>White / European descent</span></label>
            <label class="check-option"><input type="checkbox" name="race" value="Multiracial or Multiethnic" /><span>Multiracial or Multiethnic</span></label>
            <label class="check-option"><input id="raceOtherCheck" type="checkbox" name="race" value="__other__" /><span>I prefer to self-describe</span></label>
            <label class="check-option"><input id="racePna" type="checkbox" name="race" value="Prefer not to answer" /><span>Prefer not to answer</span></label>
          </div>
          <div id="raceOtherWrap" class="reveal hidden">
            <label class="demo-label" for="raceOther">Please self-describe your race or ethnicity</label>
            <input id="raceOther" class="demo-input" type="text" />
          </div>
          <div class="demo-error">Please select at least one response and complete the self-description if needed.</div>
        </fieldset>

        <div id="emailField" class="demo-field full">
          <label class="demo-label" for="email">Email <span class="optional-note">Optional</span></label>
          <input id="email" class="demo-input" type="email" autocomplete="email" placeholder="name@example.com" />
          <div class="demo-help">Provide an email only if you are willing to be contacted about this study. It is not required.</div>
          <div class="demo-error">Please enter a valid email address or leave this field blank.</div>
        </div>
      </div>
      <div id="demographicsError" class="validation">Please complete the highlighted demographic items before submitting.</div>
    </form>
  </section>
  <div id="demographicsActions" class="demographics-actions hidden">
    <button id="backToPracticeBtn" class="btn secondary" type="button">Back</button>
    <button id="submitStudyBtn" class="btn" type="button">Submit to receive SurveySwap credit</button>
  </div>


  <section id="completeScreen" class="card complete hidden">
    <div class="brandline" style="margin-bottom:10px">Study complete</div>
    <h2>Thank you for completing the leadership practice study.</h2>
    <p id="submitStatus">Your responses were submitted successfully.</p>

    <div class="completion-grid">
      <section class="completion-panel" aria-labelledby="surveySwapTitle">
        <h3 id="surveySwapTitle">SurveySwap credit</h3>
        <p class="small">If you are participating through SurveySwap, use the completion code below to receive credit.</p>
        <div class="code-box">
          <code id="surveySwapCode" class="survey-code">2CJ7-NMH8-AGX6</code>
          <button id="copySurveySwapCode" class="btn secondary" type="button">Copy code</button>
        </div>
        <div class="completion-actions">
          <a class="btn" href="https://surveyswap.io/sr/2CJ7-NMH8-AGX6" target="_blank" rel="noopener">Open SurveySwap</a>
        </div>
        <p id="copyStatus" class="small" aria-live="polite"></p>
      </section>

      <section class="completion-panel profile-panel" aria-labelledby="profileTitle">
        <h3 id="profileTitle">Discover your leadership profile</h3>
        <p class="small">Want to see your own R.I.S.E. Index™ leadership profile? You can take the R.I.S.E. Inventory now.</p>
        <div class="completion-actions">
          <a class="btn" href="https://www.renfaut.org/rise-inventory" target="_blank" rel="noopener">Take the R.I.S.E. Inventory</a>
        </div>
      </section>
    </div>
  </section>

  <div class="footer">R.I.S.E. Index™ | Renfaut™ Praxis Paradigm | Created by T. Lee Morgan, Ph.D.</div>
</div>

<script>
/*
  DEPLOYMENT NOTES
  - Balanced rotation links: append ?assignment=1 through ?assignment=12.
  - Each assignment contains two different principles, exactly one Anchoring and one Exploring practice.
