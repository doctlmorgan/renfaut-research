    if(!alpha) return false;
    if(/[;\\/]{1,}/.test(t) && alpha.length>=3) return true;
    if(alpha.length>=5 && !/[aeiouy]/.test(alpha)) return true;
    return keyboardPatterns.some(p=>alpha.includes(p));
  });
  if(suspicious.length>=2) return true;
  const words=cleanWords(clean);
  const counts={}; words.forEach(w=>counts[w]=(counts[w]||0)+1);
  if(words.length>=4 && Math.max(...Object.values(counts))/words.length>.6) return true;
  return false;
}

function meaningful(text, id='') {
  const clean=text.trim();
  const words=cleanWords(clean);
  const unique=new Set(words);
  const letters=(clean.match(/[a-zà-öø-ÿ]/gi)||[]).length;
  const q3=id.endsWith('q3');
  const minWords=q3 ? 10 : 8;
  const minUnique=q3 ? 6 : 5;
  const minLetters=q3 ? 35 : 30;
  if(words.length<minWords || unique.size<minUnique || letters<minLetters) return false;
  if(hasUnreadableFiller(clean)) return false;
  return true;
}

function showQualitativeError(id, message) {
  const area=document.getElementById(id); if(!area) return;
  const help=document.getElementById(id+'Help');
  area.classList.add('invalid-input');
  area.setAttribute('aria-invalid','true');
  if(help){ help.textContent=message; help.classList.remove('hidden'); }
}

function clearQualitativeError(id) {
  const area=document.getElementById(id); if(!area) return;
  const help=document.getElementById(id+'Help');
  area.classList.remove('invalid-input');
  area.removeAttribute('aria-invalid');
  if(help){ help.textContent=''; help.classList.add('hidden'); }
}

function updateQualitativeField(id, force=false) {
  const area=document.getElementById(id); if(!area) return true;
  const value=area.value.trim();
  if(!force){ clearQualitativeError(id); return !value || meaningful(value,id); }
  if(!value){
    showQualitativeError(id, id.endsWith('q3') ? 'Please explain your reasoning in your own words.' : 'Please enter a brief response in your own words.');
    return false;
  }
  if(hasUnreadableFiller(value)){
    showQualitativeError(id,'Please remove filler or unreadable text and respond in your own words.');
    return false;
  }
  if(!meaningful(value,id)){
    showQualitativeError(id, id.endsWith('q3') ? 'Please give a little more explanation of your reasoning.' : 'Please give a little more detail so your response can be understood.');
    return false;
  }
  clearQualitativeError(id);
  return true;
}

function setupQualitativeField(id) {
  const area=document.getElementById(id); if(!area) return;
  const showPasteBlocked=()=>showQualitativeError(id,'Please type your response in your own words. Copying and pasting is disabled.');
  area.addEventListener('paste',e=>{e.preventDefault();showPasteBlocked();});
  area.addEventListener('drop',e=>{e.preventDefault();showPasteBlocked();});
  area.addEventListener('beforeinput',e=>{if(e.inputType==='insertFromPaste'||e.inputType==='insertFromDrop'){e.preventDefault();showPasteBlocked();}});
  area.addEventListener('input',()=>clearQualitativeError(id));
}

function collectPath(num) {
  const q5=document.getElementById(`p${num}q5`).value.trim();
  const q6=document.getElementById(`p${num}q6`).value.trim();
  const answered=[q5?'5':null,q6?'6':null].filter(Boolean);
  return {
    q1: val(`p${num}q1`),
    q2: val(`p${num}q2`),
    q3: document.getElementById(`p${num}q3`).value.trim(),
    q4: val(`p${num}q4`),
    either: answered.length===2?'both':(answered[0]||''),
    q5,
    q6
  };
}

function validPath(r, num) {
  let ok=true;
  if (!r.q1 || !r.q2 || !r.q4) ok=false;
  if (!updateQualitativeField(`p${num}q3`, true)) ok=false;
  const q5id=`p${num}q5`, q6id=`p${num}q6`;
  const q5ok=!!r.q5 && meaningful(r.q5,q5id);
  const q6ok=!!r.q6 && meaningful(r.q6,q6id);
  if (r.q5 && !updateQualitativeField(q5id, true)) ok=false;
  if (r.q6 && !updateQualitativeField(q6id, true)) ok=false;
  const eitherError=document.getElementById(`p${num}eitherError`);
  if (!q5ok && !q6ok) {
    if(eitherError) eitherError.classList.remove('hidden');
    if(!r.q5 && !r.q6) ok=false;
    else ok=false;
  } else if(eitherError) eitherError.classList.add('hidden');
  return ok;
}
function saveAndContinue() {
  const num = sequence[currentIndex];
  const r = collectPath(num);
  const msg = document.getElementById('validation');
  if (!validPath(r, num)) { msg.style.display='block'; const first=document.querySelector('.invalid-input'); if(first) first.scrollIntoView({behavior:'smooth',block:'center'}); return; }
  msg.style.display='none';
  responses[num]=r;
  saveLocal();
  if (currentIndex===0) { currentIndex=1; renderPractice(); }
  else showDemographics();
}

function goBack() {
  if (currentIndex===0) return;
  const num=sequence[currentIndex];
  responses[num]=collectPath(num);
  saveLocal();
  currentIndex=0;
  renderPractice();
}

function restorePath(num) {
  const r=responses[num]; if(!r) return;
  for (const q of [1,2,4]) {
    if (r['q'+q]) { const e=document.querySelector(`input[name="p${num}q${q}"][value="${r['q'+q]}"]`); if(e)e.checked=true; }
  }
  document.getElementById(`p${num}q3`).value=r.q3||'';
  document.getElementById(`p${num}q5`).value=r.q5||'';
  document.getElementById(`p${num}q6`).value=r.q6||'';
}
function payload() {
  return {
    study:'R.I.S.E. Index Leadership Practice Study - 12 Practice',
    version:'2026-11-09',
    participant_id:participantId,
    assignment:assignmentNumber,
    sequence,
    completed_at:new Date().toISOString(),
    responses: sequence.map((num,position)=>{
      const p=byNum[num], r=responses[num];
      return {position:position+1,path_number:num,title:p.title,principle:p.principle,orientation:p.orientation,...r};
    }),
    demographics
  };
}

function saveLocal() {
  localStorage.setItem('rise_path_progress', JSON.stringify({participantId,assignmentNumber,sequence,currentIndex,responses,demographics}));
}

function selectedValues(name) {
  return [...document.querySelectorAll(`input[name="${name}"]:checked`)].map(x=>x.value);
}

function collectDemographics() {
  return {
    age_range: document.getElementById('ageRange').value,
    country: document.getElementById('country').value.trim(),
    professional_role: document.getElementById('professionalRole').value.trim(),
    sector: document.getElementById('sector').value,
    sector_other: document.getElementById('sectorOther').value.trim(),
    leadership_years: document.getElementById('leadershipYears').value,
    gender_identity: selectedValues('gender'),
    gender_other: document.getElementById('genderOther').value.trim(),
    race_ethnicity: selectedValues('race'),
    race_other: document.getElementById('raceOther').value.trim(),
    email: document.getElementById('email').value.trim()
  };
}

function restoreDemographics() {
  if(!demographics || !Object.keys(demographics).length) return;
  const set=(id,v)=>{const e=document.getElementById(id); if(e && v!=null)e.value=v;};
  set('ageRange',demographics.age_range); set('country',demographics.country); set('professionalRole',demographics.professional_role);
  set('sector',demographics.sector); set('sectorOther',demographics.sector_other); set('leadershipYears',demographics.leadership_years);
  set('genderOther',demographics.gender_other); set('raceOther',demographics.race_other); set('email',demographics.email);
  document.querySelectorAll('input[name="gender"]').forEach(e=>e.checked=(demographics.gender_identity||[]).includes(e.value));
  document.querySelectorAll('input[name="race"]').forEach(e=>e.checked=(demographics.race_ethnicity||[]).includes(e.value));
  syncDemographicReveals();
}

function markDemo(id,bad) {
  const e=document.getElementById(id); if(!e)return;
  e.classList.toggle('has-error',!!bad);
}

function validateDemographics() {
  demographics=collectDemographics();
  let ok=true;
  const rules={
    ageField:!demographics.age_range,
    countryField:!demographics.country,
    roleField:!demographics.professional_role,
    sectorField:!demographics.sector || (demographics.sector==='__other__' && !demographics.sector_other),
    yearsField:!demographics.leadership_years,
    genderField:!demographics.gender_identity.length || (demographics.gender_identity.includes('__other__') && !demographics.gender_other),
    raceField:!demographics.race_ethnicity.length || (demographics.race_ethnicity.includes('__other__') && !demographics.race_other),
    emailField:!!demographics.email && !document.getElementById('email').checkValidity()
  };
  Object.entries(rules).forEach(([id,bad])=>{markDemo(id,bad); if(bad)ok=false;});
  document.getElementById('demographicsError').style.display=ok?'none':'block';
  if(!ok){ const first=document.querySelector('#demographicsScreen .has-error'); if(first)first.scrollIntoView({behavior:'smooth',block:'center'}); }
  return ok;
}

function syncDemographicReveals() {
  document.getElementById('sectorOtherWrap').classList.toggle('hidden',document.getElementById('sector').value!=='__other__');
  document.getElementById('genderOtherWrap').classList.toggle('hidden',!document.getElementById('genderOtherCheck').checked);
  document.getElementById('raceOtherWrap').classList.toggle('hidden',!document.getElementById('raceOtherCheck').checked);
}

function setupCheckboxExclusivity(name,pnaId) {
  const pna=document.getElementById(pnaId);
  document.querySelectorAll(`input[name="${name}"]`).forEach(cb=>{
    cb.addEventListener('change',()=>{
      if(cb===pna && cb.checked){document.querySelectorAll(`input[name="${name}"]`).forEach(x=>{if(x!==pna)x.checked=false;});}
      else if(cb!==pna && cb.checked){pna.checked=false;}
      syncDemographicReveals();
    });
  });
}

function showDemographics() {
  document.getElementById('studyScreen').classList.add('hidden');
  document.getElementById('demographicsScreen').classList.remove('hidden');
  document.getElementById('demographicsActions').classList.remove('hidden');
  restoreDemographics();
  window.scrollTo({top:0,behavior:'smooth'});
}

async function finishStudy() {
  demographics=collectDemographics();
  saveLocal();
  const p=payload();
  const submitBtn=document.getElementById('submitStudyBtn');
  const msg=document.getElementById('demographicsError');
  if(submitBtn){ submitBtn.disabled=true; submitBtn.textContent='Submitting…'; }
  if(!SUBMIT_ENDPOINT){
    if(submitBtn){ submitBtn.disabled=false; submitBtn.textContent='Submit to receive SurveySwap credit'; }
    msg.textContent='This study is not connected to a response endpoint. Please contact the researcher.';
    msg.style.display='block';
    return;
  }
  try {
    const resp=await fetch(SUBMIT_ENDPOINT,{method:'POST',headers:{'Content-Type':'text/plain;charset=utf-8'},body:JSON.stringify(p)});
    if(!resp.ok) throw new Error('HTTP '+resp.status);
    localStorage.setItem('rise_path_complete', JSON.stringify(p));
    localStorage.removeItem('rise_path_progress');
    document.getElementById('demographicsScreen').classList.add('hidden');
    document.getElementById('demographicsActions').classList.add('hidden');
    document.getElementById('completeScreen').classList.remove('hidden');
    document.getElementById('submitStatus').textContent='Your responses were submitted successfully.';
    window.scrollTo({top:0,behavior:'smooth'});
  } catch(err) {
    if(submitBtn){ submitBtn.disabled=false; submitBtn.textContent='Submit to receive SurveySwap credit'; }
    msg.textContent='Your response could not be submitted. Please check your connection and select Submit again.';
    msg.style.display='block';
  }
}



const copyBtn = document.getElementById('copySurveySwapCode');
if (copyBtn) {
  copyBtn.addEventListener('click', async () => {
    const code = document.getElementById('surveySwapCode').textContent.trim();
    const status = document.getElementById('copyStatus');
    try {
      await navigator.clipboard.writeText(code);
      status.textContent = 'Completion code copied.';
    } catch (e) {
      status.textContent = 'Select the code above and copy it manually.';
    }
  });
}



document.getElementById('sector').addEventListener('change',syncDemographicReveals);
setupCheckboxExclusivity('gender','genderPna');
setupCheckboxExclusivity('race','racePna');
document.getElementById('genderOtherCheck').addEventListener('change',syncDemographicReveals);
document.getElementById('raceOtherCheck').addEventListener('change',syncDemographicReveals);

document.getElementById('backToPracticeBtn').addEventListener('click',()=>{
  demographics=collectDemographics(); saveLocal();
  document.getElementById('demographicsScreen').classList.add('hidden');
  document.getElementById('demographicsActions').classList.add('hidden');
  document.getElementById('studyScreen').classList.remove('hidden');
  currentIndex=1; renderPractice();
});

document.getElementById('submitStudyBtn').addEventListener('click',()=>{
  if(!validateDemographics()) return;
  finishStudy();
});


document.getElementById('startBtn').addEventListener('click',()=>{
  participantId=document.getElementById('participantId').value.trim();
  const ready=document.getElementById('readyCheck').checked;
  const validCode=/^[A-Za-z0-9-]{6,20}$/.test(participantId);
  if(!validCode || !ready) { document.getElementById('startError').style.display='block'; return; }
  document.getElementById('startError').style.display='none';
  assignmentNumber=getAssignment();
  sequence=assignments[String(assignmentNumber)] || assignments[assignmentNumber];
  const saved=localStorage.getItem('rise_path_progress');
  if(saved) {
    try { const s=JSON.parse(saved); if(s.participantId===participantId && s.assignmentNumber===assignmentNumber){ responses=s.responses||{}; demographics=s.demographics||{}; } } catch(e){}
  }
  document.getElementById('startScreen').classList.add('hidden');
  document.getElementById('studyScreen').classList.remove('hidden');
  renderPractice();
});
</script>
